{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/etretat", "destination": "/claude", "type": 301 },
      { "source": "/en/etretat", "destination": "/claude", "type": 301 },
      {
        "source": "/ko/etretat",
        "destination": "/claude?lang=ko",
        "type": 301
      },
      {
        "source": "/fr/etretat",
        "destination": "/claude?lang=fr",
        "type": 301
      },
      { "source": "/en", "destination": "/", "type": 301 },
      { "source": "/ko", "destination": "/?lang=ko", "type": 301 },
      { "source": "/fr", "destination": "/?lang=fr", "type": 301 },
      { "source": "/en/:rest*", "destination": "/:rest*", "type": 301 },
      { "source": "/ko/:rest*", "destination": "/:rest*?lang=ko", "type": 301 },
      { "source": "/fr/:rest*", "destination": "/:rest*?lang=fr", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
